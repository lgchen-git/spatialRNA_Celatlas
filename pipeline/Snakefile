    benchmark: str(stage_benchmark("06.segment/02.cellsegment"))
    log: str(stage_log("06.segment/02.cellsegment"))
    shell: runner_command("06.segment/02.cellsegment", "06.segment/02.cellsegment", check_path=str(CELLSEG_LABELS)) + " > {log} 2>&1"


rule bin_analysis:
    input:
        binsegment_done=str(stage_done("06.segment/01.binsegment"))
    output:
        done=str(stage_done("07.outs/binned_outputs"))
    threads: int(config["thread"])
    resources:
        mem_mb=int(config["resources"]["mem_mb"])
    benchmark: str(stage_benchmark("07.outs/binned_outputs"))
    log: str(stage_log("07.outs/binned_outputs"))
    shell: runner_command("07.outs/binned_outputs", "07.outs/binned_outputs") + " > {log} 2>&1"


rule cell_analysis:
    input:
        cellsegment_done=str(stage_done("06.segment/02.cellsegment"))
    output:
        done=str(stage_done("07.outs/cellsegmented_outputs"))
    threads: int(config["thread"])
    resources:
        mem_mb=int(config["resources"]["mem_mb"])
    benchmark: str(stage_benchmark("07.outs/cellsegmented_outputs"))
    log: str(stage_log("07.outs/cellsegmented_outputs"))
    shell: runner_command("07.outs/cellsegmented_outputs", "07.outs/cellsegmented_outputs", check_path=str(CELL_METRICS)) + " > {log} 2>&1"


rule report:
    input:
        bin_analysis_done=str(stage_done("07.outs/binned_outputs")),
        cell_analysis_done=str(stage_done("07.outs/cellsegmented_outputs")),
    output:
        done=str(stage_done("08.report"))
    threads: 2
    resources:
        mem_mb=int(config["resources"]["report_mem_mb"])
    benchmark: str(stage_benchmark("08.report"))
    log: str(stage_log("08.report"))
    shell: runner_command("08.report", "08.report", check_path=str(REPORT)) + " > {log} 2>&1"
