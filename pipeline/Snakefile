"""Celatlas Spatial v1.8 workflow driven by Snakemake."""

include: "rules/common.smk"


rule all:
    input:
        str(stage_done("08.report"))


rule sample:
    input:
        input_dir=str(INPUT_DIR)
    output:
        done=str(stage_done("00.sample"))
    threads: int(config["thread"])
    resources:
        mem_mb=int(config["resources"]["mem_mb"])
    benchmark: str(stage_benchmark("00.sample"))
    log: str(stage_log("00.sample"))
    shell: runner_command("00.sample", "00.sample") + " > {log} 2>&1"


rule barcode:
    input:
        sample_done=str(stage_done("00.sample"))
    output:
        done=str(stage_done("01.barcode"))
    threads: int(config["thread"])
    resources:
        mem_mb=int(config["resources"]["mem_mb"])
    benchmark: str(stage_benchmark("01.barcode"))
    log: str(stage_log("01.barcode"))
    shell: runner_command("01.barcode", "01.barcode") + " > {log} 2>&1"


